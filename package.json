{
  "name": "magiarium-client",
  "version": "1.0.0",
  "author": "9dryavka",
  "scripts": {
    "node:prettier": "prettier --check .",
    "node:prettier:fix": "prettier --write .",
    "node:lint": "eslint .",
    "node:lint:fix": "eslint . --fix",
    "node:check": "npm run node:prettier && npm run node:lint",
    "node:fix": "npm run node:prettier:fix && npm run node:lint:fix",
    "node:build": "npm run node:check && tsc",
    "start": "next dev --turbopack"
  },
  "dependencies": {
    "@magiarium/structure": "github:magiarium/magiarium-structure",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.0",
    "markuplint": "^4.18.3",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "typescript": "^6.0.3"
  }
}
